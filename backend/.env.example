# ── 大模型 ──────────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── 前端地址（逗号分隔多个 origin）───────────────
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174

# ── 数据库 ──────────────────────────────────────────
DATABASE_PATH=data/apanel.db

# ── 讨论参数 ────────────────────────────────────────
MAX_CONCURRENT_DISCUSSIONS=10
DEFAULT_MAX_ROUNDS=30

# ── 后端端口说明 ────────────────────────────────────
# Windows 下 8000/8010 可能被系统保留(WinError 10013)，如遇端口冲突换 8765
# 启动: uvicorn app.main:app --reload --port 8765
